{
  "name": "cc-heads-up",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code mod that mirrors your prompt draft at the top of a docked side pane, so you don't have to keep looking at the bottom of the screen.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "lefthook run check",
    "check:security": "fallow security",
    "fix": "lefthook run check --commands lint,md,fmt && fallow fix --yes --no-create-config",
    "prepare": "test -d .git && lefthook install || true",
    "test": "claude plugin test .",
    "declarations": "claude --plugin-dir ."
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.20.5",
    "cspell": "^10.3.0",
    "fallow": "^3.31.0",
    "lefthook": "^2.1.0",
    "markdownlint-cli2": "^0.23.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.0",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "markdownlint-cli2": {
      "js-yaml": "^5.2.2"
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}

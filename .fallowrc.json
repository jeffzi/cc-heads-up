{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["hooks/register.tsx", "scripts/check-declarations.ts"],
  "framework": [
    {
      "name": "claude-plugin-test",
      "enablers": ["@anthropic-ai/claude-code"],
      "entryPoints": ["tests/**/*.test.ts", "tests/**/*.test.tsx"],
      "entryPointRole": "test"
    }
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "claude-code",
    "cspell",
    "fallow",
    "lefthook",
    "markdownlint-cli2",
    "oxfmt",
    "oxlint",
    "oxlint-tsgolint"
  ],
  "duplicates": { "ignore": ["tests/**"] },
  "rules": { "duplicate-exports": "off" },
  "health": {
    "thresholdOverrides": [
      {
        "files": ["tests/**/*.test.ts", "tests/**/*.test.tsx"],
        "functions": ["<arrow>"],
        "maxUnitSize": 800,
        "reason": "describe/it callbacks are suite containers; file length is capped by oxlint max-lines"
      }
    ]
  }
}
